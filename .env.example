# Copy to .env.local and fill in. Never commit real values.
# All of these are SERVER-ONLY. Never prefix them with NEXT_PUBLIC_.

# Supabase project URL (Project Settings → API).
SUPABASE_URL=

# Supabase service role key (Project Settings → API → service_role).
# Bypasses row-level security; used only inside Next.js API routes.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: secret used to pseudonymize client IPs for rate limiting.
# Defaults to the service role key when empty. Any long random string works.
RATE_LIMIT_SECRET=

# Optional: set to 1 (with the two Supabase values above, pointing at a
# NON-production project) to run the live database integration tests.
SUPABASE_INTEGRATION_TESTS=
